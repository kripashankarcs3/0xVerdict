# 0xVerdict Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── AI Provider (Required) ────────────────────────────────────────────────────
# Get your free key at: https://openrouter.ai → Dashboard → Keys → Create Key
OPENROUTER_API_KEY=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 

# Model to use via OpenRouter (optional — defaults to gemini-2.0-flash free tier)
# Free options:
#   google/gemini-2.0-flash-exp:free   ← default, recommended
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat:free
# Paid options (better quality):
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# ── Server (Optional) ─────────────────────────────────────────────────────────
PORT=8000

# ── Persistence (Optional) ────────────────────────────────────────────────────
# Directory where completed scan JSON files are saved
SCAN_DATA_DIR=./scan_data

# ── CORS (Optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Defaults to localhost:3000 and localhost:8443 if not set
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:3000

# ── Scanner Tuning (Optional) ─────────────────────────────────────────────────
# How deep to crawl the target site (1-3 recommended)
CRAWL_DEPTH=2
# Max pages to scan per target
MAX_PAGES=30
